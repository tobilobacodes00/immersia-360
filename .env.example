# Copy to apps/web/.env.local for local development. Never commit real values.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (magic links, guest emails). Use ONE: any SMTP server (e.g. the Immersia Booth Gmail
# with an app password) or Resend. With neither, non-production builds use an in-memory dev mailbox.
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM="Immersia 360 <hello@example.com>"

# Guest files: any S3-compatible store. Cloudflare R2 in production
# (S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto), MinIO in CI.
# Guests get short-lived presigned links, so expiry and takedowns take effect at once.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 for MinIO and other path-style endpoints
S3_FORCE_PATH_STYLE=0

# Vercel Cron bearer secret (the hourly expiry sweep)
CRON_SECRET=

# Upstash Redis (rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origins
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Short domain for typed codes (DL-2). Open PRD question; falls back to APP_ORIGIN/c.
NEXT_PUBLIC_SHORT_ORIGIN=

# Realtime hub (Cloudflare Worker)
NEXT_PUBLIC_REALTIME_URL=
REALTIME_SIGNING_SECRET=

# AES-256-GCM key (base64, 32 bytes) for Drive/Dropbox refresh tokens at rest
INTEGRATION_TOKEN_KEY=
