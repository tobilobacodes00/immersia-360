# Copy to apps/web/.env.local for local development. Never commit real values.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (magic links, guest emails). Use ONE: any SMTP server (e.g. the Immersia Booth Gmail
# with an app password) or Resend. With neither, non-production builds use an in-memory dev mailbox.
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM="Immersia 360 <hello@example.com>"

# Guest files: any S3-compatible store. Cloudflare R2 in production
# (S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto), MinIO in CI.
# Guests get short-lived presigned links, so expiry and takedowns take effect at once.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 for MinIO and other path-style endpoints
S3_FORCE_PATH_STYLE=0

# Vercel Cron bearer secret (the hourly expiry sweep)
CRON_SECRET=

# Upstash Redis (rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origins
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Short domain for typed codes (DL-2). Open PRD question; falls back to APP_ORIGIN/c.
NEXT_PUBLIC_SHORT_ORIGIN=

# Live Display hub (apps/realtime, a Cloudflare Worker). https URL of the worker; screens get a
# wss:// address with a short-lived token from the feed. Same secret (32+ random bytes) on both sides.
# Without them, screens poll the feed instead.
REALTIME_URL=
REALTIME_SIGNING_SECRET=

# Bring-your-own cloud (SHR-7): the server copies finished files to the operator's own Google Drive
# or Dropbox. INTEGRATION_TOKEN_KEY is the AES-256-GCM key (base64 of 32 bytes:
# `openssl rand -base64 32`) for refresh tokens at rest. Without it, Integrations shows every
# provider as "not configured".
INTEGRATION_TOKEN_KEY=
# Google Drive: an OAuth client (Web application) with the redirect URI
# {APP_ORIGIN}/api/integrations/drive/callback and only the drive.file scope.
# Falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above when these are unset.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Dropbox: an app (access type "App folder" is enough) with the redirect URI
# {APP_ORIGIN}/api/integrations/dropbox/callback and the scopes account_info.read,
# files.metadata.read, files.metadata.write and files.content.write.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Platform admins: comma-separated email addresses allowed into /admin (success metrics, the
# reports queue). Checked on the server on every admin page and action; everyone else gets a 404.
ADMIN_EMAILS=
# Where escalated abuse reports are emailed for a legal or trust decision (optional).
TRUST_EMAIL=
