# Running it on your own machine, against `docker compose up -d` (Postgres + an S3-compatible store).
# Copy this to apps/web/.env.local and start: `pnpm --filter @immersia/web dev`.
#
# These secrets are for your laptop only. Production values go in Vercel, never here and never in git.
# Everything a hosted service would provide (email, Google sign-in, Drive, Dropbox, the Live Display
# hub, Upstash, the server render worker) is left out on purpose: the app runs without them and says
# so in the UI where a screen needs one. See .env.example for the full list.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/immersia

# Sign-in. With no SMTP server or Resend key, magic links are printed to the terminal running `dev`
# (look for "[dev-mailbox]") — that is how you sign in locally.
BETTER_AUTH_SECRET=57950a3fd79b5aeea8afd780e828613467d57d60bf684d2841cc052153532eba
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Guest files, served by the S3Mock container in docker-compose.yml.
S3_ENDPOINT=http://127.0.0.1:9090
S3_REGION=us-east-1
S3_BUCKET=immersia-local
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key
S3_FORCE_PATH_STYLE=1

# The hourly sweep (expiry, cloud copies, cleanup). Run it by hand while testing:
#   curl -H "authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/expire
CRON_SECRET=ee38a63768cf1439c5a5e5ac58a033d9

# Encrypts Drive/Dropbox refresh tokens at rest. Needed only if you connect a cloud account.
INTEGRATION_TOKEN_KEY=F9iY76tuEABewn7XXSgEiwKRilCbqhb0keJW8d1IXjU=

# Your own address here opens /admin (success metrics and the reports queue).
ADMIN_EMAILS=
