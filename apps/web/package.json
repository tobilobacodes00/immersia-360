{
  "name": "@immersia/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-fonts.mjs && node scripts/build-workers.mjs && next dev",
    "build": "node scripts/fetch-fonts.mjs && node scripts/build-workers.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@immersia/i18n": "workspace:*",
    "@immersia/shared": "workspace:*",
    "@immersia/ui": "workspace:*",
    "@serwist/turbopack": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "serwist": "catalog:",
    "zod": "catalog:",
    "@immersia/db": "workspace:*",
    "better-auth": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "resend": "catalog:",
    "@vercel/functions": "catalog:",
    "server-only": "catalog:",
    "@upstash/ratelimit": "catalog:",
    "@upstash/redis": "catalog:",
    "nodemailer": "catalog:",
    "@immersia/capture": "workspace:*",
    "@immersia/offline": "workspace:*",
    "dexie": "catalog:",
    "@immersia/render-engine": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@immersia/layout": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "esbuild": "catalog:",
    "@types/pg": "catalog:",
    "@types/nodemailer": "catalog:"
  }
}
