{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/workers/**",
        "public/fonts/lib/**",
        "public/mediapipe/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "BETTER_AUTH_*",
        "S3_*",
        "CRON_SECRET",
        "UPSTASH_*",
        "RESEND_*",
        "GOOGLE_*",
        "E2E",
        "VERCEL_*",
        "SMTP_URL",
        "EMAIL_FROM"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
